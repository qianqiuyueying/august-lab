generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String    @default("")
  content     String    @default("")
  coverImage  String    @default("")
  images      String[]  @default([])
  tags        String[]  @default([])
  readingTime Int       @default(3)
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  description String    @default("")
  content     String    @default("")
  coverImage  String    @default("")
  images      String[]  @default([])
  tags        String[]  @default([])
  status      String    @default("draft")
  runtimePath  String    @default("")
  fileSize     Int       @default(0)
  runtimeEntry String    @default("index.html")
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id         Int      @id @default(autoincrement())
  filename   String
  url        String
  alt        String   @default("")
  width      Int      @default(0)
  height     Int      @default(0)
  uploadedAt DateTime @default(now())
}

model SiteInfo {
  id              Int    @id @default(1)
  aboutBio        String @default("")
  aboutLinks      Json   @default("[]")
  siteTitle       String @default("Atelier")
  siteDescription String @default("")
  socialLinks     Json   @default("[]")
}

model MascotSettings {
  id                  Int    @id @default(1)
  enabled             Boolean @default(true)
  mascotVisible       Boolean @default(true)
  showOnMobile        Boolean @default(false)
  person              String  @default("你是一位名叫「小光」的看板娘，性格温柔亲切，擅长用简洁温暖的语言介绍这个站点的内容和设计师的创作思路。")
  apiKey              String  @default("")
  baseUrl             String  @default("https://api.openai.com/v1")
  model               String  @default("gpt-4o-mini")
  temperature         Float   @default(0.7)
  maxTokens           Int     @default(256)
  greetingEnabled     Boolean @default(true)
  greetingDelaySeconds Int    @default(8)
  dragEnabled         Boolean @default(true)
  mascotScale         Float   @default(1.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
